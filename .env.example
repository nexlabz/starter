# Each key is marked REQUIRED or OPTIONAL with what happens when it is unset.
# The full checklist is in README.md.

# ───────── REQUIRED: the server will not boot in production without these ─────────
# Postgres. Local (docker compose): postgres://postgres:postgres@localhost:5433/app
# Neon: copy the *pooled* connection string from the Neon dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# 32+ random chars:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# ───────── OPTIONAL: needed on custom domains ─────────
# Public URL of the app. Leave empty on Vercel (the production domain is detected) and locally (http://localhost:3000).
# Unset on a custom domain = sign-in fails with "Invalid origin".
NEXT_PUBLIC_APP_URL=

# ───────── OPTIONAL, recommended in production: email (Resend) ─────────
# Unset = emails print to the server console in dev. In production, nothing is delivered: copy invite links from the Team page.
RESEND_API_KEY=
EMAIL_FROM="Nexlabz Starter <onboarding@resend.dev>"

# ───────── OPTIONAL: Google sign-in (set BOTH) ─────────
# Unset = the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────── OPTIONAL: payments (Polar). See docs/BILLING.md ─────────
# Token or webhook secret unset = billing off, everyone is on Free. Product unset = that plan shows "Product not set".
POLAR_SERVER=sandbox               # sandbox | production (tokens/products are separate per environment)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO_MONTHLY=         # subscription, monthly
POLAR_PRODUCT_PRO_YEARLY=          # subscription, yearly
POLAR_PRODUCT_LIFETIME=            # one-time purchase

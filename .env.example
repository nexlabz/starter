# ───────── Required ─────────
# Postgres. Local (docker compose): postgres://postgres:postgres@localhost:5433/app
# Neon: copy the *pooled* connection string from the Neon dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# 32+ random chars:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# ───────── Recommended ─────────
# Public URL of the app. Leave empty on Vercel (the production domain is detected) and locally (http://localhost:3000).
NEXT_PUBLIC_APP_URL=

# ───────── Optional: email (Resend). Empty = emails print to the server console in dev. Required in production. ─────────
RESEND_API_KEY=
EMAIL_FROM="Nexlabz Starter <onboarding@resend.dev>"

# ───────── Optional: Google sign-in (set BOTH) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────── Optional: payments (Polar). Empty = billing disabled, everyone is on Free. See docs/BILLING.md ─────────
POLAR_SERVER=sandbox               # sandbox | production (tokens/products are separate per environment)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO_MONTHLY=         # subscription, monthly
POLAR_PRODUCT_PRO_YEARLY=          # subscription, yearly
POLAR_PRODUCT_LIFETIME=            # one-time purchase
